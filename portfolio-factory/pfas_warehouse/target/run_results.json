ution_time": 0.22899627685546875, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.pfas_warehouse.accepted_values_stg_ucmr5_results_state_code__NC.a337d6b6f9", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        state_code as value_field,\n        count(*) as n_records\n\n    from \"pfas_ucmr5\".\"main_staging\".\"stg_ucmr5_results\"\n    group by state_code\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'NC'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-24T00:31:45.922122Z", "completed_at": "2026-11-24T00:31:45.936212Z"}, {"name": "execute", "started_at": "2026-11-24T00:31:45.936996Z", "completed_at": "2026-11-24T00:31:46.060523Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.14194536209106445, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.pfas_warehouse.assert_non_negative_concentrations", "compiled": true, "compiled_code": "-- Singular data test: ensure no analytical concentration or MRL is negative.\nSELECT\n    result_row_id,\n    pwsid,\n    contaminant,\n    result_ug_l,\n    result_ppt,\n    mrl_ug_l\nFROM \"pfas_ucmr5\".\"main_staging\".\"stg_ucmr5_results\"\nWHERE (result_ug_l IS NOT NULL AND result_ug_l < 0)\n   OR (result_ppt IS NOT NULL AND result_ppt < 0)\n   OR (mrl_ug_l IS NOT NULL AND mrl_ug_l < 0)", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-24T00:31:45.813527Z", "completed_at": "2026-11-24T00:31:45.837325Z"}, {"name": "execute", "started_at": "2026-11-24T00:31:45.838396Z", "completed_at": "2026-11-24T00:31:46.100064Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.31358885765075684, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.pfas_warehouse.assert_benchmark_arithmetic", "compiled": true, "compiled_code": "-- Singular data test: verify ug/L -> ppt conversion (x1000) and benchmark_ratio arithmetic within 1e-6.\nSELECT\n    result_row_id,\n    pwsid,\n    contaminant,\n    result_ug_l,\n    result_ppt,\n    mcl_benchmark_ppt,\n    benchmark_ratio,\n    above_mcl_benchmark_flag\nFROM \"pfas_ucmr5\".\"main_intermediate\".\"int_ucmr5_pfas_screened\"\nWHERE (\n        result_ug_l IS NOT NULL\n        AND ABS(result_ppt - (result_ug_l * 1000.0)) > 1e-6\n      )\n   OR (\n        is_detected = TRUE\n        AND mcl_benchmark_ppt IS NOT NULL\n        AND result_ppt IS NOT NULL\n        AND ABS(benchmark_ratio - (result_ppt / mcl_benchmark_ppt)) > 1e-6\n      )\n   OR (\n        above_mcl_benchmark_flag = TRUE\n        AND (mcl_benchmark_ppt IS NULL OR result_ppt IS NULL OR result_ppt <= mcl_benchmark_ppt)\n      )\n   OR (\n        above_mcl_benchmark_flag = FALSE\n        AND is_detected = TRUE\n        AND mcl_benchmark_ppt IS NOT NULL\n        AND result_ppt IS NOT NULL\n        AND result_ppt > mcl_benchmark_ppt\n      )", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-24T00:31:45.850245Z", "completed_at": "2026-11-24T00:31:45.872273Z"}, {"name": "execute", "started_at": "2026-11-24T00:31:45.873036Z", "completed_at": "2026-11-24T00:31:46.246116Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.4299740791320801, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.pfas_warehouse.assert_hazard_index_bounds", "compiled": true, "compiled_code": "-- Singular data test: verify Hazard Index score is non-negative, matches component sum,\n-- and aligns with above_hi_benchmark_flag (> 1.0).\nSELECT\n    hi_event_key,\n    hazard_index_score,\n    hfpo_da_hi_component,\n    pfna_hi_component,\n    pfhxs_hi_component,\n    pfbs_hi_component,\n    above_hi_benchmark_flag\nFROM \"pfas_ucmr5\".\"main_intermediate\".\"int_system_hazard_index\"\nWHERE hazard_index_score < 0\n   OR ABS(\n        hazard_index_score - (\n            hfpo_da_hi_component\n            + pfna_hi_component\n            + pfhxs_hi_component\n            + pfbs_hi_component\n        )\n      ) > 1e-4\n   OR (above_hi_benchmark_flag = TRUE AND hazard_index_score <= 1.0)\n   OR (above_hi_benchmark_flag = FALSE AND hazard_index_score > 1.0)", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-24T00:31:45.987794Z", "completed_at": "2026-11-24T00:31:46.005384Z"}, {"name": "execute", "started_at": "2026-11-24T00:31:46.006152Z", "completed_at": "2026-11-24T00:31:46.276840Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.30832743644714355, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.pfas_warehouse.assert_row_reconciliation", "compiled": true, "compiled_code": "-- Singular data test: exact row reconciliation across ingest_audit, staging, intermediate, and marts.\nWITH audit AS (\n    SELECT source_nc_rows, loaded_nc_rows, distinct_pwsids\n    FROM \"pfas_ucmr5\".\"raw_ucmr5\".\"ingest_audit\"\n),\nstg_cnt AS (\n    SELECT COUNT(*) AS n, COUNT(DISTINCT pwsid) AS pws_n FROM \"pfas_ucmr5\".\"main_staging\".\"stg_ucmr5_results\"\n),\nint_cnt AS (\n    SELECT COUNT(*) AS n FROM \"pfas_ucmr5\".\"main_intermediate\".\"int_ucmr5_pfas_screened\"\n),\ncounty_sum AS (\n    SELECT SUM(total_samples) AS n, SUM(systems_monitored) AS pws_n FROM \"pfas_ucmr5\".\"main_marts\".\"mart_county_scorecard\"\n),\nanalyte_sum AS (\n    SELECT SUM(total_samples) AS n FROM \"pfas_ucmr5\".\"main_marts\".\"mart_analyte_summary\"\n),\nsys_cnt AS (\n    SELECT COUNT(*) AS pws_n, SUM(total_samples) AS n FROM \"pfas_ucmr5\".\"main_marts\".\"mart_system_screening\"\n)\nSELECT\n    a.source_nc_rows,\n    a.loaded_nc_rows,\n    s.n AS stg_rows,\n    i.n AS int_rows,\n    c.n AS county_mart_rows,\n    an.n AS analyte_mart_rows,\n    sy.n AS system_mart_rows,\n    a.distinct_pwsids,\n    s.pws_n AS stg_pwsids,\n    c.pws_n AS county_pwsids,\n    sy.pws_n AS system_pwsids\nFROM audit a\nCROSS JOIN stg_cnt s\nCROSS JOIN int_cnt i\nCROSS JOIN county_sum c\nCROSS JOIN analyte_sum an\nCROSS JOIN sys_cnt sy\nWHERE a.source_nc_rows <> a.loaded_nc_rows\n   OR a.loaded_nc_rows <> s.n\n   OR s.n <> i.n\n   OR s.n <> c.n\n   OR s.n <> an.n\n   OR s.n <> sy.n\n   OR a.distinct_pwsids <> s.pws_n\n   OR s.pws_n <> c.pws_n\n   OR s.pws_n <> sy.pws_n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-24T00:31:46.293730Z", "completed_at": "2026-11-24T00:31:46.343270Z"}, {"name": "execute", "started_at": "2026-11-24T00:31:46.347905Z", "completed_at": "2026-11-24T00:31:46.419834Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.13011574745178223, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.pfas_warehouse.not_null_int_ucmr5_pfas_screened_above_mcl_benchmark_flag.48d9d03f00", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect above_mcl_benchmark_flag\nfrom \"pfas_ucmr5\".\"main_intermediate\".\"int_ucmr5_pfas_screened\"\nwhere above_mcl_benchmark_flag is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-24T00:31:46.303056Z", "completed_at": "2026-11-24T00:31:46.356876Z"}, {"name": "execute", "started_at": "2026-11-24T00:31:46.358523Z", "completed_at": "2026-11-24T00:31:46.488359Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.18919873237609863, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.pfas_warehouse.not_null_int_system_hazard_index_hi_event_key.a6b8a269ea", "compiled": true, "compiled_code": "\n    