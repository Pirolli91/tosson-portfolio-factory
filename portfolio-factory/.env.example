# Build A: Job-Hunt Portfolio Factory — Environment Variable NAMES ONLY (no values)
# Copy to .env locally if overriding defaults; never commit populated .env files.

# DuckDB warehouse path used by ingest, dbt profiles.yml, SQL pack, and dashboard builder
PFAS_DUCKDB_PATH=

# Proof registry path (defaults to workspace root proof-registry.json)
PROOF_REGISTRY_PATH=

# Python & dbt binary overrides for Airflow 3 LocalExecutor tasks
PORTFOLIO_VENV_PYTHON=
PORTFOLIO_VENV_DBT=

# Apache Airflow 3 runtime directory and settings (used by .venv-airflow)
AIRFLOW_HOME=
AIRFLOW__CORE__EXECUTOR=
AIRFLOW__CORE__DAGS_FOLDER=
AIRFLOW__CORE__LOAD_EXAMPLES=

# Optional local paths for claim-verifier (A5) and JD gap analyser (A6)
VERIFIER_BASE_DOCS_PATH=
VERIFIER_REGISTRY_PATH=
