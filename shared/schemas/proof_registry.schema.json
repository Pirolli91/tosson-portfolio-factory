{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tossonanalytics.com/schemas/proof-registry-1.0.0.json",
  "title": "Sprint 5 Proof Registry",
  "description": "Versioned registry of runnable portfolio and auction intelligence artifacts backing verifiable claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "owner",
    "legal_entity",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "updated_at": {
      "type": "string",
      "minLength": 10
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "legal_entity": {
      "type": "string",
      "const": "Tosson Services LLC dba Tosson Environmental Analytics"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "kind",
          "title",
          "repo_path",
          "evidence",
          "supports_claims",
          "source_urls"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "dbt_model",
              "dag",
              "sql_pack",
              "dax_library",
              "dashboard",
              "report"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "repo_path": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "result",
              "timestamp"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "minLength": 1
              },
              "timestamp": {
                "type": "string",
                "minLength": 10
              },
              "metrics": {
                "type": "object"
              }
            }
          },
          "supports_claims": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "source_urls": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^https?://.+"
            }
          }
        }
      }
    }
  }
}
