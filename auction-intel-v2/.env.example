# Auction Intelligence v2 — Environment Variable NAMES ONLY
# Standing rule: NEVER commit credential values or secrets into this workspace.
# Copy to a local untracked .env file on the operator host if needed.

# Base path for existing auctions.tossonanalytics.com read-only snapshot exports
AUCTION_INTEL_SNAPSHOT_DIR=

# Output directory for sidecar v2 reports (separate from live dashboard webroot)
AUCTION_INTEL_V2_OUTPUT_DIR=

# Optional local path to owner-staged Facebook Marketplace sold history CSV (read-only)
AUCTION_INTEL_SOLD_HISTORY_CSV=

# Optional local path to owner-staged manifest CSV directory (read-only)
AUCTION_INTEL_MANIFEST_DIR=

# Optional local directory for cached HiBid lot images used by B2 Pillow dHash
AUCTION_INTEL_HIBID_IMAGE_DIR=

# Optional read-only public county GIS / tax-auction feed URLs for B3
AUCTION_INTEL_CASWELL_FEED_URL=
AUCTION_INTEL_ROCKINGHAM_FEED_URL=
AUCTION_INTEL_PERSON_FEED_URL=

# Optional separate monitor output directory for B4 Kia Carnival Checker (kept isolated from B1-B3)
KIA_CARNIVAL_MONITOR_OUTPUT_DIR=

# Optional HTTP user-agent identifier for polite read-only public API calls (NHTSA / county feeds)
AUCTION_INTEL_HTTP_USER_AGENT=
